########################################
# NixOS / Flakes outputs
########################################
# Common Nix build symlinks
/result
/result-*
/result.*
*.log
/inputs
########################################
# Dev shells & tooling
########################################
# pre-commit config is generated by git-hooks.nix and kept untracked.
# Hooks are synced to reference the resolved absolute config path.
/.pre-commit-config.yaml

# Gemini/Antigravity
.antigravitycli/

# Agent local testing
.mcp.json
.specify/
.understand-anything/

# direnv state
.direnv/
.envrc.local

# Tool/LSP caches (top-level and nested)
.clj-kondo/
.lsp/
.claude/
**/.clj-kondo/**
**/.lsp/**
.kiro/
tmp/
.tmp/
.code/
**/__pycache__
*.pyc
.ruff_cache/
.pytest_cache/
.mypy_cache/
.tox/
.nox/
.vscode/
.log/
log/
########################################
# Editors, OS cruft, and temp files
########################################
.idea/
.DS_Store
Thumbs.db
*.swp
*.swo
*~
*.tgz
# scripts/update-nixos-manual.sh tempdir; only visible after kill -9
# since the EXIT trap normally removes it.
/.nixos-manual-update.*
tmp_*
*_tmp*
########################################
# Language/vendor caches (safe defaults)
########################################
node_modules/
.cache/
.wrangler/
########################################
# Secrets safety (defense-in-depth)
# Do not commit private keys or local env files
########################################
*.agekey
*.key
*.pem
*.p12
*.pfx
.env
.env.*
# Common SSH/private key patterns (allow public keys)
id_*
!id_*.pub
# Mirrors secrets/.gitignore (**/decrypted_*, *.dec.*) so
# scripts/lib/secrets-guard.sh, which parses this block for its deny list,
# recognises them in the submodule working trees path: copies whole.
# Anchored under the gitlink, which git never descends into, so they stay
# inert for git: unanchored they would also match at the superproject
# root, where a stray cleartext file is untracked today and therefore
# caught by git status and by ensure_clean_git_tree. The guard reduces
# every pattern to its last component, so it denies both names at any
# depth anyway; the anchor scopes git's rule, not that scan.
secrets/**/decrypted_*
secrets/**/*.dec.*

