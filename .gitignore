########################################
# NixOS / Flakes outputs
########################################
# Common Nix build symlinks
/result
/result-*
/result.*
*.log
/inputs
########################################
# Dev shells & tooling
########################################
# pre-commit config is generated by git-hooks.nix and kept untracked.
# Hooks are synced to reference the resolved absolute config path.
/.pre-commit-config.yaml

# Gemini/Antigravity
.antigravitycli/

# Agent local testing
.mcp.json
.specify/
.understand-anything/

# direnv state
.direnv/
.envrc.local

# Tool/LSP caches (top-level and nested)
.clj-kondo/
.lsp/
.claude/
**/.clj-kondo/**
**/.lsp/**
.kiro/
tmp/
.tmp/
.code/
**/__pycache__
*.pyc
.ruff_cache/
.pytest_cache/
.mypy_cache/
.tox/
.nox/
.vscode/
.log/
log/
########################################
# Editors, OS cruft, and temp files
########################################
.idea/
.DS_Store
Thumbs.db
*.swp
*.swo
*~
*.tgz
# scripts/update-nixos-manual.sh tempdir; only visible after kill -9
# since the EXIT trap normally removes it.
/.nixos-manual-update.*
tmp_*
*_tmp*
########################################
# Language/vendor caches (safe defaults)
########################################
node_modules/
.cache/
.wrangler/
########################################
# Secrets safety (defense-in-depth)
# Do not commit private keys or local env files
########################################
*.agekey
*.key
*.pem
*.p12
*.pfx
.env
.env.*
# Common SSH/private key patterns (allow public keys)
id_*
!id_*.pub
# Mirrors secrets/.gitignore (**/decrypted_*, *.dec.*). Git will not apply
# these across the gitlink, so they change nothing for the submodule
# itself; scripts/lib/secrets-guard.sh parses this block for its deny list
# and matches it against submodule paths too, which is what stops that
# scan from having to report every ignored file it finds there.
decrypted_*
*.dec.*

