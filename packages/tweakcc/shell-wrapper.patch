+/**
+ * Resolves the static target used by a shell launcher. NixOS home-manager
+ * wrappers use this form when the executable must be selected at runtime:
+ * `target=/absolute/path/to/claude` followed by `exec "$target" "$@"`.
+ */
+async function resolveShellWrapper(wrapperPath: string): Promise<string | null> {
+  try {
+    const wrapper = await fs.readFile(wrapperPath, 'utf8');
+    const targetMatch = wrapper.match(
+      /^\s*target=(?:"([^"]+)"|'([^']+)'|([^\s#]+))\s*$/m
+    );
+    const target = targetMatch?.[1] ?? targetMatch?.[2] ?? targetMatch?.[3];
+    if (!target || !target.startsWith('/')) {
+      return null;
+    }
+
+    const resolved = await fs.realpath(target);
+    debug(`resolveShellWrapper: resolved ${wrapperPath} -> ${resolved}`);
+    return resolved;
+  } catch (error) {
+    debug('resolveShellWrapper: could not resolve shell target:', error);
+    return null;
+  }
+}
