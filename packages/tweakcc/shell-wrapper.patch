+/**
+ * Resolves static targets used by shell launchers. Home Manager wrappers use
+ * `target=/absolute/path/to/claude`, while makeWrapper uses
+ * `exec -a "<argv0>" "/absolute/path/to/.name-wrapped"`.
+ * The producer is `modules/agents/claude-code/_wrapper.nix`.
+ */
+async function resolveShellWrapper(wrapperPath: string): Promise<string | null> {
+  try {
+    const wrapper = await fs.readFile(wrapperPath, 'utf8');
+    const targetMatch = wrapper.match(
+      /^\s*target=(?:"([^"]+)"|'([^']+)'|([^\s#]+))\s*$/m
+    );
+    const execTargetMatch = wrapper.match(
+      /^\s*exec\s+(?:-a\s+(?:"[^"]*"|'[^']*'|\S+)\s+)?(["'])(\/[^"'\n]*\/\.[^"'\n/]+-wrapped_*)\1/m
+    );
+    const target =
+      targetMatch?.[1] ??
+      targetMatch?.[2] ??
+      targetMatch?.[3] ??
+      execTargetMatch?.[2];
+    if (!target || !target.startsWith('/')) {
+      return null;
+    }
+
+    const resolved = await fs.realpath(target);
+    debug(`resolveShellWrapper: resolved ${wrapperPath} -> ${resolved}`);
+    return resolved;
+  } catch (error) {
+    debug('resolveShellWrapper: could not resolve shell target:', error);
+    return null;
+  }
+}
